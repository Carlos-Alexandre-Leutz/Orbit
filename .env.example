# Copy this file to `.env` and fill in the values. `.env` is ignored by Git: never commit it.
# Every value below is a placeholder, not a real secret.

# --- PostgreSQL container (docker compose): required ---
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orbit
POSTGRES_PORT=5432

# --- MongoDB container (docker compose): required ---
MONGO_USER=orbit
MONGO_PASSWORD=change-me
MONGO_PORT=27017

# --- Store API (apps/api-tasks) ---
# DATABASE_URL is required. Compose builds it from the POSTGRES_* values; set it yourself only when running the API outside Compose.
DATABASE_URL=postgresql://orbit:change-me@localhost:5432/orbit?schema=public
# Signs login sessions. Use a random value of 32+ characters outside your laptop: the API refuses `change-me` when NODE_ENV=production.
JWT_SECRET=change-me
# Optional: how long a session lasts, in seconds (default 3600)
# JWT_EXPIRES_IN_SECONDS=3600
# Password-reset e-mail through an SMTP server (a Mailtrap sandbox works). Needed only to send that e-mail; the API starts without them.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=change-me
MAIL_PASS=change-me
MAIL_FROM=no-reply@example.com
# Optional: link base used in the reset e-mail (default http://localhost:3000)
APP_URL=http://localhost:3000
# Optional: port of the API (default 3002)
# PORT=3002

# --- BFF (apps/bff) ---
# Required: address of the store API
TASKS_API_URL=http://localhost:3002
# Optional: comma-separated list of allowed web origins (default http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

# --- Web (apps/web) ---
# Address of the BFF as seen by the browser. Baked in at build time.
NEXT_PUBLIC_BFF_URL=http://localhost:3001
