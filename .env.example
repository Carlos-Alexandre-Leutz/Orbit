# Copy this file to `.env` and fill in the values. `.env` is ignored by Git: never commit it.
# Every value below is a placeholder, not a real secret.

# --- PostgreSQL container (docker compose): required ---
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orbit
POSTGRES_PORT=5432

# --- MongoDB container (docker compose): required ---
MONGO_USER=orbit
MONGO_PASSWORD=change-me
MONGO_PORT=27017

# --- Store API (apps/api-tasks) ---
# DATABASE_URL is required. Compose builds it from the POSTGRES_* values; set it yourself only when running the API outside Compose.
DATABASE_URL=postgresql://orbit:change-me@localhost:5432/orbit?schema=public
# Signs login sessions. Use a random value of 32+ characters outside your laptop: the API refuses `change-me` when NODE_ENV=production.
JWT_SECRET=change-me
# Optional: how long a session lasts, in seconds (default 3600)
# JWT_EXPIRES_IN_SECONDS=3600
# Optional: how long a temporary visitor account lasts, in hours (default 24)
# ANONYMOUS_TTL_HOURS=24
# How e-mail leaves the API: `smtp` (default, the MAIL_* variables below) or `http` (the owner's free-email-send-api).
# MAIL_PROVIDER=http
# MAIL_API_URL=https://freeemailsenderapi.duckdns.org
# MAIL_API_TOKEN=change-me
# Password-reset e-mail through an SMTP server (a Mailtrap sandbox works). Needed only to send that e-mail; the API starts without them.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=change-me
MAIL_PASS=change-me
MAIL_FROM=no-reply@example.com
# The contact e-mail shown at the bottom of the Terms of Use and the Privacy Policy (read by the web server). Without it the pages say to use the contact published on the site.
# SUPPORT_EMAIL=
# Payments. Without these two the API uses a fake provider that charges nothing (tests and development only); in production it refuses to start without them. Use Stripe TEST keys (sk_test_...) and the signing secret of a test-mode webhook pointing at <BFF>/payments/webhook (whsec_...).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# The matching PUBLISHABLE key, read by the web server (pk_test_... or pk_live_...). With it the pay page shows a real card field; without it, the simulated test-card picker. It must be from the same Stripe account and mode as the secret key: test keys everywhere except production, live keys only in production.
# STRIPE_PUBLISHABLE_KEY=
# Each seller connects their own payment provider in the panel (ADR-008). Their secret keys are encrypted with this key before they are stored; without it the panel refuses to save them. Make one with: openssl rand -base64 32. Losing or changing it makes every stored credential unreadable, so keep a copy.
# PAYMENT_ENCRYPTION_KEY=
# The secret address (one word: letters, digits, hyphen; 4 to 32 characters) of the owner's area. Choose one nobody can guess and keep it out of the repository. Without it the area does not exist. Read by the API, the BFF and the web server.
# ADMIN_PATH=
# Orbit's OWN Mercado Pago account, used to charge the monthly plan of the sellers (ADR-009); not the seller's account. The access token of an application with subscriptions, and the secret signature of its webhook. Point that webhook at <BFF_PUBLIC_URL>/billing/webhook and select the subscription events. Without them the "start free trial" button says billing is not set up.
# ORBIT_BILLING_MP_ACCESS_TOKEN=
# ORBIT_BILLING_MP_WEBHOOK_SECRET=
# ORBIT_BILLING_MP_PUBLIC_KEY=
# The address of the BFF as the payment providers see it (they must reach it from the internet). The panel shows sellers the webhook address built from it: <BFF_PUBLIC_URL>/payments/webhook/<store>. Read by the web server.
# BFF_PUBLIC_URL=http://localhost:3001
# Optional: link base used in the reset e-mail (default http://localhost:3000)
APP_URL=http://localhost:3000
# Optional: port of the API (default 3002)
# PORT=3002

# Execution traces (PBI-12): the MongoDB where traces are saved; tracing is off when empty.
# MONGO_URL=mongodb://orbit:change-me@localhost:27017/orbit?authSource=admin
# TRACE_TTL_DAYS=30

# Language model (PBI-17): Gemini key and the models to try, in order; all optional.
# GEMINI_API_KEY=
# LLM_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# LLM_TIMEOUT_MS=30000
# LLM_PRICES_JSON={"gemini-2.5-flash":{"input":0.3,"output":2.5}}

# --- BFF (apps/bff) ---
# Required: address of the store API
TASKS_API_URL=http://localhost:3002
# Optional: comma-separated list of allowed web origins (default http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

# --- Web (apps/web) ---
# Address of the BFF as seen by the browser. Baked in at build time.
NEXT_PUBLIC_BFF_URL=http://localhost:3001
# Optional: how the web server (not the browser) reaches the BFF. Compose sets http://bff:3001; without it the address above is used.
# BFF_URL=http://bff:3001
